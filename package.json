{
  "name": "oc-codemode-follower",
  "version": "0.1.0",
  "description": "OpenCode V2 plugin: follow a trigger MCP server's enabled state and switch Code Mode for a target set of MCP servers",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "check": "tsc --noEmit",
    "security": "bun audit --registry=https://registry.npmjs.org",
    "ci": "bun run lint && bun run check && bun run security"
  },
  "dependencies": {
    "@opencode/plugin": "^2.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
